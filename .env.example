# Copy to .env and replace both passwords with independent long random values.
WP_DB_PASSWORD=CHANGE_TO_A_LONG_RANDOM_DATABASE_PASSWORD
WP_DB_ROOT_PASSWORD=CHANGE_TO_A_DIFFERENT_LONG_RANDOM_PASSWORD
WP_LOCAL_PORT=8080
# For production, use the public HTTPS WordPress address (e.g. https://cms.example.com).
WP_PUBLIC_URL=http://localhost:8080
# Vite reads this at build time. Set to the same public address as WP_PUBLIC_URL.
VITE_WORDPRESS_URL=http://localhost:8080
